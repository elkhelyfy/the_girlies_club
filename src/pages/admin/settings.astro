---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { SETTING_FIELDS, getSettings, saveSettings, type SettingKey } from "../../lib/content";
import { back } from "../../lib/forms";

const PAGE = "/admin/settings";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const values: Partial<Record<SettingKey, string>> = {};
  for (const field of SETTING_FIELDS) {
    const value = form.get(field.key);
    if (typeof value === "string") values[field.key] = value.slice(0, 600);
  }
  await saveSettings(values);
  return Astro.redirect(back(PAGE, { saved: "Site text saved." }));
}

const settings = await getSettings();
---

<AdminLayout title="Site text" intro="Words used across the site. Leave a field empty to go back to the original text.">
  <section class="panel">
    <form class="form" method="post">
      {
        SETTING_FIELDS.map((field) => (
          <label>
            {field.label}
            {"hint" in field && <small>{field.hint}</small>}
            {"multiline" in field ? (
              <textarea name={field.key} placeholder={field.default}>{settings[field.key]}</textarea>
            ) : (
              <input name={field.key} value={settings[field.key]} placeholder={field.default} />
            )}
          </label>
        ))
      }
      <div class="actions">
        <button class="abtn" type="submit">Save site text</button>
      </div>
    </form>
  </section>
</AdminLayout>
