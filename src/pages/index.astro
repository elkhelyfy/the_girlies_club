---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import Pillars from "../components/Pillars.astro";
import Sessions from "../components/Sessions.astro";
import HowItWorks from "../components/HowItWorks.astro";
import CommunityWall from "../components/CommunityWall.astro";
import PrivateEvents from "../components/PrivateEvents.astro";
import Membership from "../components/Membership.astro";
import Testimonials from "../components/Testimonials.astro";
import Faq from "../components/Faq.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";
import Motion from "../components/Motion.astro";
import { faqs, testimonials, wallPosts } from "../lib/content";
import { upcomingEvents } from "../lib/bookings";

const upcoming = await upcomingEvents();
const wall = await wallPosts();
const [quotes, questions] = await Promise.all([testimonials(), faqs()]);
const fromPrice = upcoming.length ? Math.min(...upcoming.map((e) => e.price)) : null;
---

<Base
  title="The Girlies Club — craft workshops & pause café in Casablanca"
  description="Crochet, peinture and broderie workshops for women in Casablanca. Small tables, every material included, pause café halfway through. Private events too — on se déplace."
>
  <Header />

  <main id="main">
    <Hero />
    <Stats />
    <Pillars />
    <Sessions events={upcoming.slice(0, 4)} total={upcoming.length} />
    <HowItWorks />
    <CommunityWall posts={wall.slice(0, 10)} total={wall.length} />
    <PrivateEvents />
    <Membership />
    <Testimonials items={quotes} />
    <Faq items={questions} />
    <Closing fromPrice={fromPrice} />
  </main>

  <Footer />
  <Motion />
</Base>
