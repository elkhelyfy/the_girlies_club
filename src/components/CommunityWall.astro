---
import type { WallPost } from "../lib/content";
import Button from "./ui/Button.astro";
import Eyebrow from "./ui/Eyebrow.astro";
import Icon from "./ui/Icon.astro";
import Sticker from "./ui/Sticker.astro";
import WallTile from "./WallTile.astro";

interface Props {
  /** A preview — featured pieces first, then the newest. */
  posts: WallPost[];
  total: number;
}

const { posts, total } = Astro.props;
const { handle, followers } = Astro.locals.settings;
---

<section class="section section--night wall" id="community">
  <span class="wall__sticker" aria-hidden="true" data-spin="1">
    <Sticker lines={["Made", "it!"]} fill="var(--lime)" ink="var(--ink)" rotate={9} />
  </span>

  <div class="shell">
    <header class="center-col wall__head" data-reveal>
      <Eyebrow icon="📸" tone="night">The wall</Eyebrow>
      <h2 class="display display--lg">
        Everything on this page<br />
        <span class="tint-heat">was made in the room</span>
      </h2>
      <p class="lede">
        No stock photos. Every piece below left the studio in someone's tote bag — tap a name to find the maker on
        Instagram. Tag {handle} and yours goes up next.
      </p>
    </header>

    <ul class="wall__grid">
      {posts.map((post, i) => <WallTile post={post} index={i} />)}
    </ul>

    <div class="wall__cta" data-reveal>
      <span class="wall__ctaText">
        <Icon name="instagram" />
        <span><b>{total}</b> pieces and counting · <b>{followers}</b> girlies follow along</span>
      </span>
      <Button href="/wall" variant="solid" size="sm" arrow>See the whole wall</Button>
    </div>
  </div>
</section>

<style>
  .wall {
    position: relative;
    overflow: hidden;
  }

  .wall__sticker {
    position: absolute;
    display: block;
    top: clamp(1rem, 3vw, 2.5rem);
    right: clamp(0.5rem, 4vw, 5rem);
    width: clamp(88px, 10vw, 132px);
    z-index: 2;
  }

  .wall__head {
    gap: 1.15rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
    max-width: 62ch;
    margin-inline: auto;
  }

  /* --- masonry-ish grid --------------------------------------------------- */

  .wall__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 1fr;
    gap: 0.9rem;
  }

  .wall__cta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: fit-content;
    margin: clamp(2rem, 4vw, 3rem) auto 0;
    padding: 0.55rem 0.55rem 0.55rem 1.4rem;
    border-radius: var(--r-pill);
    background: var(--pink-soft);
    color: var(--ink);
    font-size: var(--step-0);
  }

  .wall__cta :global(.btn) {
    border-radius: var(--r-pill);
  }

  .wall__ctaText {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  .wall__ctaText b {
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .wall__cta {
      flex-direction: column;
      width: auto;
      padding: 1rem 1.1rem;
      border-radius: var(--r-lg);
      text-align: center;
    }
  }

  @media (min-width: 640px) {
    .wall__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .wall__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
