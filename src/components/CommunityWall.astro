---
import { Image } from "astro:assets";
import { gallery, site } from "../data/site";
import Button from "./ui/Button.astro";
import Eyebrow from "./ui/Eyebrow.astro";
import Icon from "./ui/Icon.astro";
import Sticker from "./ui/Sticker.astro";
---

<section class="section section--night wall" id="community">
  <span class="wall__sticker" aria-hidden="true" data-spin="1">
    <Sticker lines={["Made", "it!"]} fill="var(--lime)" ink="var(--ink)" rotate={9} />
  </span>

  <div class="shell">
    <header class="center-col wall__head" data-reveal>
      <Eyebrow icon="📸" tone="night">The wall</Eyebrow>
      <h2 class="display display--lg">
        Everything on this page<br />
        <span class="tint-heat">was made in the room</span>
      </h2>
      <p class="lede">
        No stock photos. Every piece below left the studio in someone's tote bag. Tag{" "}
        {site.handle} and yours goes up next.
      </p>
    </header>

    <ul class="wall__grid">
      {
        gallery.map((item, i) => (
          <li
            class={`tile ${item.span === "tall" ? "tile--tall" : ""}`}
            data-reveal
            style={`--reveal-delay:${(i % 5) * 70}ms`}
          >
            <Image
              src={item.image}
              alt={item.alt}
              widths={[280, 460, 640]}
              sizes="(min-width: 1100px) 300px, (min-width: 640px) 32vw, 46vw"
              loading="lazy"
            />

            {item.featured && (
              <span class="tile__flag">
                <Icon name="heart" /> Featured
              </span>
            )}

            <span class="tile__ig" aria-hidden="true">
              <Icon name="instagram" />
            </span>

            <div class="tile__foot">
              <span class="tile__who">
                <i style={`background:${item.dot}`} aria-hidden="true" />
                <span>
                  <b>{item.handle}</b>
                  <em>{item.session}</em>
                </span>
              </span>
              <span class="tile__likes">
                <Icon name="heart" />
                {item.likes}
              </span>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="wall__cta" data-reveal>
      <span class="wall__ctaText">
        <Icon name="instagram" />
        <span><b>{site.followers}</b> girlies follow along — more creations every week</span>
      </span>
      <Button href={site.instagram} external variant="solid" size="sm" arrow>Follow {site.handle}</Button>
    </div>
  </div>
</section>

<style>
  .wall {
    position: relative;
    overflow: hidden;
  }

  .wall__sticker {
    position: absolute;
    display: block;
    top: clamp(1rem, 3vw, 2.5rem);
    right: clamp(0.5rem, 4vw, 5rem);
    width: clamp(88px, 10vw, 132px);
    z-index: 2;
  }

  .wall__head {
    gap: 1.15rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
    max-width: 62ch;
    margin-inline: auto;
  }

  /* --- masonry-ish grid --------------------------------------------------- */

  .wall__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 1fr;
    gap: 0.9rem;
  }

  .tile {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: var(--r-md);
    /* Several uploads are cut-out PNGs — a light backing stops the deep burgundy
       showing through and keeps them reading as flat-lay shots. */
    background: #f7efe9;
    transition: transform 0.3s var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .tile:hover {
      transform: translateY(-4px);
    }
  }

  /* Absolutely positioned so the image can't inflate the ratio box. */
  .tile :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 55%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.72), transparent);
    pointer-events: none;
  }

  .tile__flag,
  .tile__ig {
    position: absolute;
    top: 0.6rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-size: 0.72rem;
  }

  .tile__flag {
    left: 0.6rem;
    padding: 0.3rem 0.65rem;
    border-radius: var(--r-pill);
    background: var(--lime);
    color: var(--ink);
    font-weight: 500;
  }

  .tile__ig {
    right: 0.6rem;
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: rgba(77, 1, 25, 0.72);
    color: var(--paper);
    font-size: 0.85rem;
  }

  .tile__foot {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.7rem;
    color: var(--paper);
  }

  .tile__who {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .tile__who i {
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
    border-radius: 50%;
  }

  .tile__who span {
    display: grid;
    min-width: 0;
  }

  .tile__who b {
    font-size: 0.78rem;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tile__who em {
    font-size: 0.66rem;
    font-style: normal;
    color: rgba(255, 255, 255, 0.62);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tile__likes {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    flex: none;
    font-size: 0.74rem;
  }

  .wall__cta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: fit-content;
    margin: clamp(2rem, 4vw, 3rem) auto 0;
    padding: 0.55rem 0.55rem 0.55rem 1.4rem;
    border-radius: var(--r-pill);
    background: var(--pink-soft);
    color: var(--ink);
    font-size: var(--step-0);
  }

  .wall__cta :global(.btn) {
    border-radius: var(--r-pill);
  }

  .wall__ctaText {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  .wall__ctaText b {
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .wall__cta {
      flex-direction: column;
      width: auto;
      padding: 1rem 1.1rem;
      border-radius: var(--r-lg);
      text-align: center;
    }
  }

  @media (min-width: 640px) {
    .wall__grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .tile--tall {
      grid-row: span 2;
      aspect-ratio: auto;
    }
  }

  @media (min-width: 1100px) {
    .wall__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
