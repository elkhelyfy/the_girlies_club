  class?: string;
}

const { name, class: className = "" } = Astro.props;

const PATHS: Record<string, string> = {
  box: "M21 8l-9-5-9 5v8l9 5 9-5V8zM3 8l9 5 9-5M12 13v8",
  spark:
    "M12 3l1.9 5.6a2 2 0 001.5 1.5L21 12l-5.6 1.9a2 2 0 00-1.5 1.5L12 21l-1.9-5.6a2 2 0 00-1.5-1.5L3 12l5.6-1.9a2 2 0 001.5-1.5L12 3z",
  heart:
    "M12 20s-7-4.5-7-9.5A4 4 0 0112 8a4 4 0 017 2.5C19 15.5 12 20 12 20z",
  trend: "M3 17l6-6 4 4 8-8M15 7h6v6",
  bolt: "M13 2L4 14h7l-1 8 9-12h-7l1-8z",
  arrow: "M5 12h14M13 6l6 6-6 6",
  arrowUp: "M12 19V5M6 11l6-6 6 6",
  check: "M4 12l5 5L20 6",
  quote:
    "M9 7H5v6h4v-2H7V9h2V7zm10 0h-4v6h4v-2h-2V9h2V7z",
  instagram:
    "M12 8.5a3.5 3.5 0 100 7 3.5 3.5 0 000-7zM4 8a4 4 0 014-4h8a4 4 0 014 4v8a4 4 0 01-4 4H8a4 4 0 01-4-4V8zm12.5-.5h.01",
  facebook: "M14 8h2V5h-2a3 3 0 00-3 3v2H9v3h2v6h3v-6h2l1-3h-3V8.8c0-.5.3-.8.5-.8z",
  youtube:
    "M3 12c0-2.2.2-3.4.4-4a2 2 0 011.3-1.3C5.9 6.3 9 6.2 12 6.2s6.1.1 7.3.5A2 2 0 0120.6 8c.2.6.4 1.8.4 4s-.2 3.4-.4 4a2 2 0 01-1.3 1.3c-1.2.4-4.3.5-7.3.5s-6.1-.1-7.3-.5A2 2 0 013.4 16c-.2-.6-.4-1.8-.4-4zM10.5 9.8l4 2.2-4 2.2V9.8z",
  star: "M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L3.5 9.7l5.9-.9L12 3.5z",
  message: "M4 12a8 8 0 1114.2 5.1L20 21l-4.2-1.3A8 8 0 014 12zm5-.5h.01m3 0h.01m3 0h.01",
  plus: "M12 5v14M5 12h14",
  pin: "M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0113 0c0 4.8-6.5 11-6.5 11zm0-8.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5z",
};

const d = PATHS[name] ?? PATHS.spark;
const filled = name === "quote";
---

<svg
  class={`icon ${className}`}
  viewBox="0 0 24 24"
  fill={filled ? "currentColor" : "none"}
  stroke={filled ? "none" : "currentColor"}
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <path d={d}></path>
</svg>

<style>
  .icon {
    width: 1em;
    height: 1em;
    flex: none;
  }
</style>
