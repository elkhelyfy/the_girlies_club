---
import { steps } from "../data/site";
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";
---

<section class="section how" id="how">
  <div class="shell">
    <header class="center-col how__head" data-reveal>
      <h2 class="display display--lg">
        From empty hands<br />to something real
      </h2>
      <p class="lede">Never made anything before? That is genuinely the point.</p>
    </header>

    <ol class="how__grid">
      {
        steps.map((step, i) => (
          <li
            class="step"
            data-reveal
            style={`--surface:${step.surface}; --reveal-delay:${i * 110}ms`}
          >
            <span class="step__num">{String(i + 1).padStart(2, "0")}</span>
            <span class="step__icon">
              <Icon name={step.icon} />
            </span>
            <h3 class="step__title">{step.title}</h3>
            <p class="step__body">{step.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="how__cta" data-reveal>
      <span>Ready to book a table?</span>
      <Button href="/calendar" variant="solid" size="sm">See the calendar</Button>
    </div>
  </div>
</section>

<style>
  .how {
    background: var(--paper);
  }

  .how__head {
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .how__grid {
    display: grid;
    gap: 1.5rem;
    counter-reset: step;
  }

  .step {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2rem);
    padding-right: clamp(4.5rem, 8vw, 5.5rem);
    border: var(--edge);
    border-radius: var(--r-lg);
    background: linear-gradient(150deg, var(--burgundy-tint) 0%, #fff7ed 100%);
  }

  .step__num {
    display: block;
    margin-bottom: 0.6rem;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--ink-40);
  }

  .step__icon {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    border: var(--edge);
    border-radius: var(--r-md);
    background: var(--surface);
    font-size: 1.35rem;
    rotate: -7deg;
  }

  .step__title {
    font-family: var(--font-body);
    font-size: var(--step-2);
    font-weight: 500;
    text-transform: none;
    line-height: 1.15;
  }

  .step__body {
    margin-top: 0.5rem;
    max-width: 34ch;
    color: var(--ink-60);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .how__cta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: fit-content;
    margin: clamp(2rem, 4vw, 3rem) auto 0;
    padding: 0.55rem 0.55rem 0.55rem 1.4rem;
    border: var(--edge);
    border-radius: var(--r-pill);
    background: var(--pink-soft);
    font-size: var(--step-0);
  }

  .how__cta :global(.btn) {
    border-radius: var(--r-pill);
  }

  @media (min-width: 900px) {
    .how__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
