---
/**
 * One bookable session — a seat at a dated event, never a product.
 * Used on the home page grid and in the calendar's "coming up" list.
 */
import type { EventRow } from "../lib/bookings";
import { tone } from "../lib/content";
import { dayMonth, weekday } from "../lib/dates";
import { price } from "../data/site";
import Button from "./ui/Button.astro";
import Flower from "./ui/Flower.astro";
import Pic from "./ui/Pic.astro";

interface Props {
  event: EventRow;
  index?: number;
  /** Adds an "add to my calendar" link (calendar page). */
  withIcs?: boolean;
}

const { event: e, index = 0, withIcs = false } = Astro.props;

const t = tone(e.tone);
const { phase } = e;
const bookable = phase === "open" || phase === "full";
const nearlyFull = phase === "open" && e.seats_left <= 4;
const taken = Math.min(1, Math.max(0, (e.capacity - e.seats_left) / e.capacity));
const availability =
  phase === "cancelled"
    ? "This session is cancelled"
    : phase === "closed"
      ? "Bookings are closed"
      : phase === "full"
        ? "Fully booked — join the wait list"
        : nearlyFull
          ? `Only ${e.seats_left} seat${e.seats_left === 1 ? "" : "s"} left`
          : `${e.seats_left} of ${e.capacity} seats left`;
const flag = phase === "cancelled" ? "Cancelled" : phase === "full" ? "Full" : phase === "closed" ? "Closed" : null;
---

<li
  class:list={["card", { "is-cancelled": phase === "cancelled" }]}
  id={`event-${e.id}`}
  data-reveal
  style={`--accent:${t.accent}; --soft:${t.soft}; --taken:${taken.toFixed(3)}; --reveal-delay:${(index % 4) * 90}ms`}
>
  <div class="card__media">
    {
      e.image ? (
        <Pic
          src={e.image}
          alt={e.alt}
          widths={[320, 560, 720]}
          sizes="(min-width: 1100px) 300px, (min-width: 700px) 44vw, 90vw"
        />
      ) : (
        <div class="card__art" aria-hidden="true">
          <span class="card__hoop">
            <Flower name="tulip" size={58} rotate={-8} float={0} />
          </span>
        </div>
      )
    }
    {flag ? <span class="card__new card__new--flag">{flag}</span> : e.is_new === 1 && <span class="card__new">New</span>}
    <span class="card__date">
      <b>{weekday(e.date)}</b>
      {dayMonth(e.date)}
    </span>
    <span class="card__craft" lang="fr">{e.craft}</span>
  </div>

  <div class="card__body">
    <div class="card__row">
      <h3 class="card__name">{e.name}</h3>
      <span class="card__level">{e.level}</span>
    </div>

    {e.blurb && <p class="card__blurb">{e.blurb}</p>}

    <dl class="card__meta">
      <div>
        <dt class="sr-only">Time</dt>
        <dd>{e.start_time} – {e.end_time}{e.location && ` · ${e.location}`}</dd>
      </div>
      <div>
        <dt class="sr-only">Availability</dt>
        <dd class={phase !== "open" || nearlyFull ? "is-low" : ""}>
          {availability}
          <span class="card__seatbar" aria-hidden="true"><i></i></span>
        </dd>
      </div>
    </dl>

    <div class="card__foot">
      <p class="card__price">
        {price(e.price)}
        <span>/ seat</span>
      </p>
      {
        bookable ? (
          <Button href={`/reserve/${e.id}`} variant="solid" size="sm" arrow>
            {phase === "full" ? "Wait list" : "Reserve"}
            <span class="sr-only"> a seat at {e.name}</span>
          </Button>
        ) : (
          <span class="card__closed">{phase === "cancelled" ? "Cancelled" : "Closed"}</span>
        )
      }
    </div>

    {
      withIcs && phase !== "cancelled" && (
        <a class="card__ics" href={`/calendar/${e.id}.ics`} download>
          + Add to my calendar
        </a>
      )
    }
  </div>
</li>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: var(--edge);
    border-radius: var(--r-lg);
    background: var(--paper);
    box-shadow: var(--float);
    transition:
      transform 0.3s var(--ease-out),
      box-shadow 0.3s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 26px 50px -24px rgba(70, 20, 60, 0.45);
    }
  }

  .card__media {
    position: relative;
    flex: none;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-bottom: var(--edge);
    background: var(--soft);
  }

  /* Absolutely positioned so the image can't inflate the ratio box. */
  .card__media > :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Photo-less sessions get the tulip in an embroidery hoop instead. */
  .card__art {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--accent) 25%, transparent) 1px, transparent 0) 0 0 / 14px 14px,
      var(--soft);
  }

  .card__hoop {
    display: grid;
    place-items: center;
    width: 62%;
    aspect-ratio: 1;
    border: 7px solid #d6a46b;
    border-radius: 50%;
    background: #fffaf2;
    box-shadow:
      0 0 0 2px #b9834a,
      inset 0 0 0 2px rgba(185, 131, 74, 0.35),
      0 18px 30px -18px rgba(10, 60, 30, 0.6);
  }

  .card__new {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    padding: 0.3rem 0.65rem;
    border: 1.5px solid var(--ink);
    border-radius: var(--r-pill);
    background: var(--lime);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card__date {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    display: grid;
    justify-items: center;
    padding: 0.45rem 0.7rem;
    border-radius: var(--r-sm);
    background: var(--paper);
    box-shadow: 0 6px 16px -10px rgba(10, 10, 10, 0.8);
    font-size: 0.7rem;
    line-height: 1.25;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .card__date b {
    font-size: 0.68rem;
    color: var(--ink-40);
  }

  .card__craft {
    position: absolute;
    right: 0.8rem;
    bottom: 0.8rem;
    padding: 0.32rem 0.7rem;
    border-radius: var(--r-pill);
    background: rgba(10, 10, 10, 0.82);
    color: var(--paper);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.8rem;
    padding: 1.35rem;
  }

  .card__row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .card__name {
    font-size: clamp(1.15rem, 1.5vw, 1.4rem);
    line-height: 1.02;
  }

  .card__level {
    padding: 0.28rem 0.62rem;
    border-radius: var(--r-sm);
    background: color-mix(in srgb, var(--accent) 16%, white);
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .card__blurb {
    color: var(--ink-60);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  .card__meta {
    display: grid;
    gap: 0.3rem;
    margin: 0;
    padding-top: 0.2rem;
    font-size: var(--step--1);
    color: var(--ink-60);
  }

  .card__meta dd {
    margin: 0;
  }

  .card__meta .is-low {
    color: var(--hot-pink);
    font-weight: 500;
  }

  /* How full the table is — fills in once, when the card first scrolls in. */
  .card__seatbar {
    display: block;
    height: 4px;
    margin-top: 0.35rem;
    overflow: hidden;
    border-radius: var(--r-pill);
    background: rgba(10, 10, 10, 0.07);
  }

  .card__seatbar i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
    transform: scaleX(var(--taken));
    transform-origin: left;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js .card:not(.is-in) .card__seatbar i) {
      transform: scaleX(0);
    }

    .card__seatbar i {
      transition: transform 0.9s var(--ease-out);
      transition-delay: calc(var(--reveal-delay, 0ms) + 250ms);
    }
  }

  .card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(10, 10, 10, 0.08);
  }

  .card__price {
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  .card__price span {
    margin-left: 0.25em;
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--ink-40);
  }

  .card__new--flag {
    background: var(--paper);
    color: var(--burgundy);
  }

  .card.is-cancelled .card__media,
  .card.is-cancelled .card__name,
  .card.is-cancelled .card__price {
    opacity: 0.55;
  }

  .card.is-cancelled .card__name {
    text-decoration: line-through;
    text-decoration-thickness: 2px;
  }

  .card__closed {
    padding: 0.5rem 0.85rem;
    border-radius: var(--r-sm);
    background: rgba(10, 10, 10, 0.06);
    color: var(--ink-60);
    font-size: var(--step--1);
    font-weight: 500;
  }

  .card__ics {
    align-self: flex-start;
    margin-top: -0.2rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--burgundy);
  }

  @media (hover: hover) and (pointer: fine) {
    .card__ics:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }
</style>
