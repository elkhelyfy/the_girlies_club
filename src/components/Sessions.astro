---
import { Image } from "astro:assets";
import { price, sessions, site } from "../data/site";
import Button from "./ui/Button.astro";
import Eyebrow from "./ui/Eyebrow.astro";
import Flower from "./ui/Flower.astro";
---

<section class="section section--wash sessions" id="sessions">
  <div class="sessions__garden" aria-hidden="true">
    <span class="bloom bloom--l" data-drift><Flower name="tulip" size={104} rotate={-10} float={9} /></span>
  </div>

  <div class="shell">
    <header class="center-col sessions__head" data-reveal>
      <Eyebrow icon="🌸">Next dates</Eyebrow>
      <h2 class="display display--lg sessions__title">
        Pick your<br />
        <span class="tint-loud">main character moment</span>
      </h2>
      <p class="lede">
        Small tables, twelve seats at most. Reserve with a quick DM on Instagram and bring
        nothing but yourself.
      </p>
    </header>

    <ul class="sessions__grid">
      {
        sessions.map((s, i) => {
          const nearlyFull = s.seats <= 4;
          const taken = (s.capacity - s.seats) / s.capacity;
          return (
            <li
              class="card"
              data-reveal
              style={`--accent:${s.accent}; --taken:${taken.toFixed(3)}; --reveal-delay:${i * 90}ms`}
            >
              <div class={`card__media card__media--${s.tone}`}>
                {s.image ? (
                  <Image
                    src={s.image}
                    alt={s.alt ?? ""}
                    widths={[320, 560, 720]}
                    sizes="(min-width: 1100px) 300px, (min-width: 700px) 44vw, 90vw"
                    loading="lazy"
                  />
                ) : (
                  <div class="card__art" aria-hidden="true">
                    <span class="card__hoop">
                      <Flower name="tulip" size={58} rotate={-8} float={0} />
                    </span>
                  </div>
                )}
                {s.isNew && <span class="card__new">New</span>}
                <span class="card__date">
                  <b>{s.day}</b>
                  {s.date}
                </span>
                <span class="card__craft" lang="fr">{s.craft}</span>
              </div>

              <div class="card__body">
                <div class="card__row">
                  <h3 class="card__name">{s.name}</h3>
                  <span class="card__level">{s.level}</span>
                </div>

                <p class="card__blurb">{s.blurb}</p>

                <dl class="card__meta">
                  <div>
                    <dt class="sr-only">Time</dt>
                    <dd>{s.time}</dd>
                  </div>
                  <div>
                    <dt class="sr-only">Availability</dt>
                    <dd class={nearlyFull ? "is-low" : ""}>
                      {nearlyFull ? `Only ${s.seats} seats left` : `${s.seats} of ${s.capacity} seats left`}
                      <span class="card__seatbar" aria-hidden="true"><i /></span>
                    </dd>
                  </div>
                </dl>

                <div class="card__foot">
                  <p class="card__price">
                    {price(s.seat)}
                    <span>/ seat</span>
                  </p>
                  <Button href={site.dm} external variant="solid" size="sm" arrow>
                    Reserve<span class="sr-only"> a seat at {s.name} via Instagram</span>
                  </Button>
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>

    <div class="sessions__note" data-reveal>
      <span class="sessions__dots" aria-hidden="true">
        <i style="background:var(--peri)"></i>
        <i style="background:var(--coral)"></i>
        <i style="background:var(--lime)"></i>
      </span>
      <p class="display display--md sessions__noteTitle">
        Every seat comes with everything —<br />
        <span class="tint-heat">including the girlies.</span>
      </p>
      <p class="lede">
        Materials, tools and the pause café. New dates drop on Instagram first — follow{" "}
        {site.handle} so you don't miss the next one.
      </p>
      <Button href={site.instagram} external variant="solid" arrow>See every date on Instagram</Button>
    </div>
  </div>
</section>

<style>
  .sessions {
    position: relative;
    overflow: hidden;
  }

  .sessions__garden {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .sessions__garden .bloom {
    position: absolute;
    display: block;
  }

  .bloom--l {
    top: 6%;
    left: 1.5%;
  }

  .sessions .shell {
    position: relative;
    z-index: 1;
  }

  .sessions__head {
    gap: 1.15rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .sessions__title {
    margin-top: 0.35rem;
  }

  .sessions__grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  /* --- session card ------------------------------------------------------ */

  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: var(--edge);
    border-radius: var(--r-lg);
    background: var(--paper);
    box-shadow: var(--float);
    transition:
      transform 0.3s var(--ease-out),
      box-shadow 0.3s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 26px 50px -24px rgba(70, 20, 60, 0.45);
    }
  }

  /* Photo-less sessions get the tulip in an embroidery hoop instead. */
  .card__art {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 1px 1px, rgba(29, 122, 76, 0.22) 1px, transparent 0) 0 0 / 14px 14px,
      linear-gradient(150deg, #dcfce7 0%, #a4f4cf 100%);
  }

  .card__hoop {
    display: grid;
    place-items: center;
    width: 62%;
    aspect-ratio: 1;
    border: 7px solid #d6a46b;
    border-radius: 50%;
    background: #fffaf2;
    box-shadow:
      0 0 0 2px #b9834a,
      inset 0 0 0 2px rgba(185, 131, 74, 0.35),
      0 18px 30px -18px rgba(10, 60, 30, 0.6);
  }

  .card__new {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    padding: 0.3rem 0.65rem;
    border-radius: var(--r-pill);
    background: var(--lime);
    border: 1.5px solid var(--ink);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card__media {
    position: relative;
    flex: none;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-bottom: var(--edge);
  }

  .card__media--blush {
    background: var(--burgundy-tint);
  }
  .card__media--peri {
    background: #dbeafe;
  }
  .card__media--amber {
    background: #fef3c6;
  }
  .card__media--mint {
    background: #dcfce7;
  }

  /* Absolutely positioned so the image can't inflate the ratio box. */
  .card__media > :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__date {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    display: grid;
    justify-items: center;
    padding: 0.45rem 0.7rem;
    border-radius: var(--r-sm);
    background: var(--paper);
    box-shadow: 0 6px 16px -10px rgba(10, 10, 10, 0.8);
    font-size: 0.7rem;
    line-height: 1.25;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .card__date b {
    font-size: 0.68rem;
    color: var(--ink-40);
  }

  .card__craft {
    position: absolute;
    right: 0.8rem;
    bottom: 0.8rem;
    padding: 0.32rem 0.7rem;
    border-radius: var(--r-pill);
    background: rgba(10, 10, 10, 0.82);
    color: var(--paper);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.8rem;
    padding: 1.35rem;
  }

  .card__row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .card__name {
    font-size: clamp(1.15rem, 1.5vw, 1.4rem);
    line-height: 1.02;
  }

  .card__level {
    padding: 0.28rem 0.62rem;
    border-radius: var(--r-sm);
    background: color-mix(in srgb, var(--accent) 16%, white);
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .card__blurb {
    color: var(--ink-60);
    font-size: var(--step--1);
    line-height: 1.55;
  }

  .card__meta {
    display: grid;
    gap: 0.3rem;
    margin: 0;
    padding-top: 0.2rem;
    font-size: var(--step--1);
    color: var(--ink-60);
  }

  .card__meta dd {
    margin: 0;
  }

  .card__meta .is-low {
    color: var(--hot-pink);
    font-weight: 500;
  }

  /* How full the table is — fills in once, when the card first scrolls in. */
  .card__seatbar {
    display: block;
    height: 4px;
    margin-top: 0.35rem;
    overflow: hidden;
    border-radius: var(--r-pill);
    background: rgba(10, 10, 10, 0.07);
  }

  .card__seatbar i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
    transform: scaleX(var(--taken));
    transform-origin: left;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js .card:not(.is-in) .card__seatbar i) {
      transform: scaleX(0);
    }

    .card__seatbar i {
      transition: transform 0.9s var(--ease-out);
      transition-delay: calc(var(--reveal-delay, 0ms) + 250ms);
    }
  }

  .card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.9rem;
    border-top: 1px solid rgba(10, 10, 10, 0.08);
  }

  .card__price {
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  .card__price span {
    margin-left: 0.25em;
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--ink-40);
  }

  /* --- closing note ------------------------------------------------------ */

  .sessions__note {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding: clamp(2rem, 5vw, 3.25rem) clamp(1.25rem, 4vw, 3rem);
    border: var(--edge);
    border-radius: var(--r-xl);
    background: var(--paper);
    text-align: center;
  }

  .sessions__dots {
    display: flex;
    gap: 0.4rem;
  }

  .sessions__dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .sessions__noteTitle {
    font-family: var(--font-body);
    font-weight: 500;
    text-transform: none;
    line-height: 1.2;
  }

  @media (max-width: 1200px) {
    .sessions__garden {
      display: none;
    }
  }

  @media (min-width: 700px) {
    .sessions__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .sessions__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
