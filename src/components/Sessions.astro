---
import type { EventRow } from "../lib/bookings";
import Button from "./ui/Button.astro";
import Eyebrow from "./ui/Eyebrow.astro";
import Flower from "./ui/Flower.astro";
import SessionCard from "./SessionCard.astro";

interface Props {
  /** The next few upcoming events. */
  events: EventRow[];
  /** How many upcoming events exist in total (for the calendar link). */
  total: number;
}

const { events, total } = Astro.props;
const { handle, instagramUrl } = Astro.locals.settings;
---

<section class="section section--wash sessions" id="sessions">
  <div class="sessions__garden" aria-hidden="true">
    <span class="bloom bloom--l" data-drift><Flower name="tulip" size={104} rotate={-10} float={9} /></span>
  </div>

  <div class="shell">
    <header class="center-col sessions__head" data-reveal>
      <Eyebrow icon="🌸">Next dates</Eyebrow>
      <h2 class="display display--lg sessions__title">
        Pick your<br />
        <span class="tint-loud">main character moment</span>
      </h2>
      <p class="lede">
        Small tables, twelve seats at most. Reserve online in a minute — we confirm by WhatsApp or Instagram. Bring
        nothing but yourself.
      </p>
    </header>

    {
      events.length ? (
        <ul class="sessions__grid">
          {events.map((event, i) => (
            <SessionCard event={event} index={i} />
          ))}
        </ul>
      ) : (
        <div class="sessions__empty" data-reveal>
          <Flower name="tulip" size={56} rotate={-8} float={0} />
          <p>
            <b>New dates are being planned.</b> Follow {handle} to hear first.
          </p>
        </div>
      )
    }

    <div class="sessions__note" data-reveal>
      <span class="sessions__dots" aria-hidden="true">
        <i style="background:var(--peri)"></i>
        <i style="background:var(--coral)"></i>
        <i style="background:var(--lime)"></i>
      </span>
      <p class="display display--md sessions__noteTitle">
        Every seat comes with everything —<br />
        <span class="tint-heat">including the girlies.</span>
      </p>
      <p class="lede">
        Materials, tools and the pause café.
        {total > events.length ? ` ${total} dates are on the calendar right now.` : ""} New ones drop on Instagram first
        — follow {handle} so you don't miss the next one.
      </p>
      <div class="sessions__actions">
        <Button href="/calendar" variant="solid" arrow>Open the calendar</Button>
        <Button href={instagramUrl} external variant="outline">Follow on Instagram</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .sessions {
    position: relative;
    overflow: hidden;
  }

  .sessions__garden {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .sessions__garden .bloom {
    position: absolute;
    display: block;
  }

  .bloom--l {
    top: 6%;
    left: 1.5%;
  }

  .sessions .shell {
    position: relative;
    z-index: 1;
  }

  .sessions__head {
    gap: 1.15rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .sessions__title {
    margin-top: 0.35rem;
  }

  .sessions__grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  .sessions__empty {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2rem;
    border: 1.5px dashed rgba(177, 2, 61, 0.35);
    border-radius: var(--r-xl);
    background: rgba(255, 255, 255, 0.7);
    text-align: left;
  }

  /* --- closing note ------------------------------------------------------ */

  .sessions__note {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding: clamp(2rem, 5vw, 3.25rem) clamp(1.25rem, 4vw, 3rem);
    border: var(--edge);
    border-radius: var(--r-xl);
    background: var(--paper);
    text-align: center;
  }

  .sessions__dots {
    display: flex;
    gap: 0.4rem;
  }

  .sessions__dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .sessions__noteTitle {
    font-family: var(--font-body);
    font-weight: 500;
    text-transform: none;
    line-height: 1.2;
  }

  .sessions__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  @media (max-width: 1200px) {
    .sessions__garden {
      display: none;
    }
  }

  @media (min-width: 700px) {
    .sessions__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .sessions__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
