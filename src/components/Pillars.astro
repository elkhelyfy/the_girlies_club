---
import { Image } from "astro:assets";
import { perks, pillars } from "../data/site";
import Eyebrow from "./ui/Eyebrow.astro";
import Icon from "./ui/Icon.astro";
import Sticker from "./ui/Sticker.astro";
---

<section class="section pillars" id="workshops">
  <div class="shell">
    <header class="center-col pillars__head" data-reveal>
      <Eyebrow icon="⚡">The workshops</Eyebrow>
      <h2 class="display display--lg pillars__title">
        Your creative era<br />starts here
      </h2>
      <p class="lede">Paint on glass, mirrors and canvas, or pick up a hook. Broderie joins the rotation this season — pick the one that matches your energy.</p>
    </header>

    <ul class="perks" data-reveal>
      {
        perks.map((perk) => (
          <li class="perk">{perk.label}</li>
        ))
      }
    </ul>

    <div class="pillars__grid">
      {
        pillars.map((pillar, i) => (
          <article
            class="pillar"
            data-reveal
            style={`--surface:${pillar.surface}; --reveal-delay:${i * 110}ms`}
          >
            <div class="pillar__media">
              <Image
                src={pillar.image}
                alt={pillar.alt}
                widths={[320, 520, 720]}
                sizes="(min-width: 1100px) 300px, (min-width: 640px) 45vw, 92vw"
                loading="lazy"
              />
            </div>

            <div class="pillar__text">
              <h3 class="pillar__title">
                {pillar.title.map((line) => (
                  <span>{line}</span>
                ))}
              </h3>

              <p class="pillar__body">{pillar.body}</p>

              <p class="pillar__note">
                <Icon name="check" />
                {pillar.note}
              </p>
            </div>
          </article>
        ))
      }

      <span class="pillars__sticker" aria-hidden="true" data-spin="-1">
        <Sticker
          lines={["Yarn", "over", "drama"]}
          fill="var(--blush)"
          ink="var(--burgundy-dark)"
          rotate={-9}
        />
      </span>
    </div>
  </div>
</section>

<style>
  .pillars {
    background: var(--paper);
  }

  .pillars__head {
    gap: 1.15rem;
    margin-bottom: 2.5rem;
  }

  .pillars__title {
    margin-top: 0.35rem;
  }

  /* --- perk chips -------------------------------------------------------- */

  .perks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.75rem);
  }

  .perk {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.7rem 1.2rem;
    border: 1px solid rgba(10, 10, 10, 0.12);
    border-radius: var(--r-pill);
    background: var(--paper);
    font-size: var(--step--1);
    box-shadow: 0 6px 18px -14px rgba(10, 10, 10, 0.5);
  }

  /* --- pillar cards ------------------------------------------------------ */

  .pillars__grid {
    position: relative;
    display: grid;
    gap: 1.15rem;
    max-width: 1120px;
    margin-inline: auto;
  }

  .pillar {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: var(--edge);
    border-radius: var(--r-md);
    background: var(--paper);
    box-shadow: var(--float);
  }

  /* Portrait crop — the photo carries the card, the copy sits under it. */
  .pillar__media {
    position: relative;
    aspect-ratio: 4 / 5;
    border-bottom: var(--edge);
  }

  /* Absolutely positioned so the portrait shots can't inflate the ratio box. */
  .pillar__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pillar__text {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
    padding: 1rem 1.1rem 1.1rem;
  }

  .pillar__title {
    display: grid;
    font-size: var(--step-1);
    line-height: 1.05;
    max-width: 15ch;
  }

  .pillar__body {
    color: var(--ink-70);
    font-size: 0.83rem;
    line-height: 1.5;
  }

  /* The card is white now — the palette lives in this tinted chip. */
  .pillar__note {
    display: flex;
    align-items: center;
    gap: 0.45em;
    align-self: flex-start;
    margin-top: auto;
    padding: 0.35rem 0.7rem;
    border-radius: var(--r-pill);
    background: var(--surface);
    font-size: 0.72rem;
    font-weight: 500;
  }

  .pillars__sticker {
    display: none;
  }

  @media (min-width: 640px) {
    .pillars__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .pillars__grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .pillars__sticker {
      display: block;
      position: absolute;
      top: -3.25rem;
      left: 24%;
      z-index: 2;
      width: 122px;
    }
  }
</style>
